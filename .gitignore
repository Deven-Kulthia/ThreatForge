# --- secrets: never commit ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets.json
credentials.json

# --- competition material: Mastercard retains IP in Event materials (Rules §5).
# Raw captures of the competition pages are kept locally for reference only and are
# deliberately excluded from the public repository. research/competition.md quotes
# only the minimum necessary.
research/*.html
research/kaggle-raw/

# --- python ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- node / frontend ---
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo
*.local

# --- artifacts ---
# metrics.json and screenshots ARE tracked: the README and deck cite them as evidence,
# and a reviewer should be able to see the reported numbers without running the harness.
# Runtime state (audit database, generated datasets) is not.
*.log
data/generated/
artifacts/*.db
artifacts/*.sqlite3
*.db
*.sqlite3

# --- os / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# Intermediate render for the project-explainer PDF; the PDF itself is the artifact.
artifacts/aegis-project-explained.html

# Firecrawl scratch output
.firecrawl/

# Submission archive (rebuild with scripts/make_submission_zip.sh)
artifacts/aegis-submission.zip

# Stray extraction of the submission archive (Finder double-click creates this)
artifacts/aegis-submission/
